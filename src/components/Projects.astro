    let startFlower: (() => void) | null = null;
    let stopFlower: (() => void) | null = null;

    function buildBreadcrumb(key: string): string {
      // Walk up the parents chain to build the full path
      const chain: string[] = [];
      let cursor: string | null = key;
      while (cursor) {
        chain.unshift(cursor);
        cursor = parents[cursor] ?? null;
      }

      const parts: string[] = [];
      chain.forEach((k, i) => {
        const isLast = i === chain.length - 1;
        if (k === "root") {
          parts.push(`<span class="path-segment path-root" data-nav="root">~/projects</span>`);
        } else if (isLast) {
          parts.push(`<span class="path-segment path-current">${pathLabels[k]}</span>`);
        } else {
          parts.push(`<span class="path-segment path-link" data-nav="${k}">${pathLabels[k]}</span>`);
        }
      });
      return parts.join('<span class="path-sep">/</span>');
    }

    function showView(key: string) {
      // Stop matrix, pretext, connectz, and flower animations when leaving views
      if (stopMatrix) stopMatrix();
      if (stopPretext) stopPretext();
      if (stopConnectz) stopConnectz();
      if (stopFlower) stopFlower();

      // Pause the flowers intro video whenever we leave it
      const flowersVideo = document.querySelector<HTMLVideoElement>(".flowers-video");
      if (flowersVideo && key !== "flowers") {
        flowersVideo.pause();
      }

      currentKey = key;

      Object.values(views).forEach((v) => v.classList.add("hidden"));
      views[key].classList.remove("hidden");
      views[key].style.animation = "fadeSlideIn 0.35s ease forwards";
      terminalTitle.textContent = titles[key];

      // Cherry-blossom theme toggle for Digital_Art subtree
      if (SAKURA_VIEWS.has(key)) {
        terminalWindow.classList.add("theme--sakura");
      } else {
        terminalWindow.classList.remove("theme--sakura");
      }

      terminalPath.innerHTML = buildBreadcrumb(key);
      if (key === "root") {
        backBtn.classList.add("hidden");
      } else {
        backBtn.classList.remove("hidden");
      }

      // Start matrix animation when entering that view
      if (key === "matrix" && startMatrix) {
        setTimeout(startMatrix, 100);
      }

      // Start pretext animation when entering that view
      if (key === "pretextMatrix" && startPretext) {
        setTimeout(startPretext, 100);
      }

      // Start connectz globe animation when entering that view
      if (key === "connectz" && startConnectz) {
        setTimeout(startConnectz, 100);
      }

      // Start the ASCII osaka flower when entering flowers view
      if (key === "flowers" && startFlower) {
        setTimeout(startFlower, 100);
      }

      // Wire up clickable breadcrumb segments (root + intermediate parents)
      terminalPath.querySelectorAll<HTMLElement>("[data-nav]").forEach((el) => {
        const navKey = el.dataset.nav;
        if (navKey) el.addEventListener("click", () => showView(navKey));
      });
    }

    document.querySelectorAll(".fs-folder").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = (btn as HTMLElement).dataset.target;
        if (target) showView(target);
      });
    });

    backBtn.addEventListener("click", () => {
      const parent = parents[currentKey] ?? "root";
