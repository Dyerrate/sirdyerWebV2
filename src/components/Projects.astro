      const gradient = pretextCtx.createRadialGradient(
        pretextUmbrellaX + PRETEXT_UMBRELLA_RADIUS,
        pretextUmbrellaY + PRETEXT_UMBRELLA_RADIUS,
        PRETEXT_UMBRELLA_RADIUS - 10,
        pretextUmbrellaX + PRETEXT_UMBRELLA_RADIUS,
        pretextUmbrellaY + PRETEXT_UMBRELLA_RADIUS,
        PRETEXT_UMBRELLA_RADIUS + 20
