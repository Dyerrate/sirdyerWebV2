        pretextUmbrellaY + PRETEXT_UMBRELLA_RADIUS,
        PRETEXT_UMBRELLA_RADIUS + 20,
        0,
        Math.PI * 2
      );
      pretextCtx.fill();

      if (pretextRunning) {
        pretextAnimationId = requestAnimationFrame(drawPretext);
      }
    }

    startPretext = function() {
