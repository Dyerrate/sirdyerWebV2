      const rect = umbrella.getBoundingClientRect();
      const touch = e.touches[0];
      dragOffsetX = touch.clientX - rect.left;
      dragOffsetY = touch.clientY - rect.top;
      umbrella.classList.add("dragging");
      e.preventDefault();
    }, { passive: false });

    document.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      const containerRect = matrixContainer.getBoundingClientRect();
      umbrellaX = Math.max(0, Math.min(containerRect.width - UMBRELLA_RADIUS * 2, e.clientX - containerRect.left - dragOffsetX));
      umbrellaY = Math.max(0, Math.min(containerRect.height - UMBRELLA_RADIUS * 2, e.clientY - containerRect.top - dragOffsetY));
      updateUmbrellaPosition();
    });

    document.addEventListener("touchmove", (e) => {
