      const containerRect = matrixContainer.getBoundingClientRect();
      const touch = e.touches[0];
      umbrellaX = Math.max(0, Math.min(containerRect.width - UMBRELLA_RADIUS * 2, touch.clientX - containerRect.left - dragOffsetX));
      umbrellaY = Math.max(0, Math.min(containerRect.height - UMBRELLA_RADIUS * 2, touch.clientY - containerRect.top - dragOffsetY));
