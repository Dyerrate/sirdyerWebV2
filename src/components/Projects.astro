    // ── Connectz 3D dotted globe (three.js) ──
    const connectzCanvas = document.getElementById("connectzCanvas") as HTMLCanvasElement;
    let connectzRunning = false;
    let connectzAnimationId: number | null = null;
    let connectzT = 0;

    // Scene state
    let cScene: THREE.Scene | null = null;
    let cCamera: THREE.PerspectiveCamera | null = null;
    let cRenderer: THREE.WebGLRenderer | null = null;
    let cGlobeGroup: THREE.Group | null = null;
    let cSatGeom: THREE.BufferGeometry | null = null;

    // Satellite orbits
    const cSats = [
      { orbitR: 1.18, tilt: 0.25, phase: 0,            speed: 0.55 },
      { orbitR: 1.32, tilt: -0.48, phase: Math.PI / 2, speed: -0.38 },
      { orbitR: 1.50, tilt: 0.85, phase: Math.PI,      speed: 0.75 },
      { orbitR: 1.25, tilt: -0.7, phase: Math.PI * 0.6, speed: -0.45 },
    ];

    // Continent seed blobs on unit sphere (lat, lon in rad, radius, strength)
    const CONTINENTS = [
      { lat: 0.95, lon: -1.75, r: 0.55, s: 1.00 }, // N America north
      { lat: 0.50, lon: -1.55, r: 0.38, s: 0.85 }, // N America south
      { lat: -0.30, lon: -1.10, r: 0.48, s: 0.95 }, // S America
      { lat: 0.25, lon: 0.35, r: 0.55, s: 1.00 }, // Africa
      { lat: 0.95, lon: 0.35, r: 0.25, s: 0.70 }, // Europe
      { lat: 0.95, lon: 1.30, r: 0.55, s: 1.00 }, // Asia
      { lat: 0.30, lon: 1.60, r: 0.30, s: 0.75 }, // India/SE Asia
      { lat: -0.45, lon: 2.35, r: 0.28, s: 0.70 }, // Australia
      { lat: -1.25, lon: 0.0, r: 0.45, s: 0.55 }, // Antarctica
    ];

    function landScore(lat: number, lon: number): number {
      let best = 0;
      for (const c of CONTINENTS) {
        const cosD =
          Math.sin(lat) * Math.sin(c.lat) +
          Math.cos(lat) * Math.cos(c.lat) * Math.cos(lon - c.lon);
        const gd = Math.acos(Math.max(-1, Math.min(1, cosD)));
        const f = Math.max(0, 1 - gd / c.r) * c.s;
        if (f > best) best = f;
      }
      // Layered noise for ragged coastlines
      const n =
        Math.sin(lat * 8 + lon * 5) * 0.055 +
        Math.cos(lat * 11 - lon * 7) * 0.045 +
        Math.sin(lat * 17 + lon * 13) * 0.035;
      return best + n;
    }

    function buildGlobePoints(): THREE.BufferGeometry {
      const TOTAL = 18000;
      const pos: number[] = [];
      const col: number[] = [];
      const COAST = { r: 1.0, g: 1.0, b: 1.0 };
      const LAND = { r: 1.0, g: 0.82, b: 0.55 };
      const OCEAN = { r: 0.32, g: 0.18, b: 0.06 };

      for (let i = 0; i < TOTAL; i++) {
        const y = 1 - (i / (TOTAL - 1)) * 2;
        const rad = Math.sqrt(1 - y * y);
        const theta = i * Math.PI * (3 - Math.sqrt(5));
        const x = Math.cos(theta) * rad;
        const z = Math.sin(theta) * rad;

        const lat = Math.asin(y);
        const lon = Math.atan2(z, x);
        const score = landScore(lat, lon);
        const rnd = Math.random();

        let c: { r: number; g: number; b: number };
        if (score > 0.55) {
          if (rnd < 0.35) continue;
          c = LAND;
        } else if (score > 0.47) {
          c = COAST;
        } else if (score > 0.40) {
          if (rnd < 0.65) continue;
          c = LAND;
        } else {
          if (rnd < 0.965) continue;
          c = OCEAN;
        }
        pos.push(x, y, z);
        col.push(c.r, c.g, c.b);
      }

      const geom = new THREE.BufferGeometry();
      geom.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));
      geom.setAttribute("color", new THREE.Float32BufferAttribute(col, 3));
      return geom;
    }

    function initConnectz() {
      const parent = connectzCanvas.parentElement;
      if (!parent) return;
      const rect = parent.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      if (!cRenderer) {
        cRenderer = new THREE.WebGLRenderer({
          canvas: connectzCanvas,
          antialias: true,
          alpha: false,
        });
        cRenderer.setClearColor(0x05040a, 1);
      }
      cRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      cRenderer.setSize(rect.width, rect.height, true);

      if (!cScene) {
        cScene = new THREE.Scene();
        cCamera = new THREE.PerspectiveCamera(36, rect.width / rect.height, 0.1, 100);
        cCamera.position.set(0, 0.35, 3.6);
        cCamera.lookAt(0, 0, 0);

        cGlobeGroup = new THREE.Group();
        cGlobeGroup.rotation.z = -0.32; // axial tilt
        cScene.add(cGlobeGroup);

        const globeGeom = buildGlobePoints();
        const globeMat = new THREE.PointsMaterial({
          size: 0.022,
          vertexColors: true,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.95,
          depthWrite: false,
        });
        const globe = new THREE.Points(globeGeom, globeMat);
        cGlobeGroup.add(globe);

        // Satellites
        const satPos = new Float32Array(cSats.length * 3);
        cSatGeom = new THREE.BufferGeometry();
        cSatGeom.setAttribute("position", new THREE.BufferAttribute(satPos, 3));
        const satMat = new THREE.PointsMaterial({
          color: 0xffd88a,
          size: 0.045,
          sizeAttenuation: true,
          transparent: true,
          opacity: 1,
          depthWrite: false,
        });
        const satellites = new THREE.Points(cSatGeom, satMat);
        satellites.frustumCulled = false;
        cScene.add(satellites);

        // Distant starfield behind the globe
        const STAR_COUNT = 500;
        const starPos = new Float32Array(STAR_COUNT * 3);
        for (let i = 0; i < STAR_COUNT; i++) {
          const u = Math.random() * 2 - 1;
          const t = Math.random() * Math.PI * 2;
          const sr = Math.sqrt(1 - u * u);
          const R = 25;
          starPos[i * 3] = Math.cos(t) * sr * R;
          starPos[i * 3 + 1] = u * R;
          starPos[i * 3 + 2] = Math.sin(t) * sr * R;
        }
        const starGeom = new THREE.BufferGeometry();
        starGeom.setAttribute("position", new THREE.BufferAttribute(starPos, 3));
        const starMat = new THREE.PointsMaterial({
          color: 0xff9c55,
          size: 0.9,
          sizeAttenuation: false,
          transparent: true,
          opacity: 0.25,
          depthWrite: false,
        });
        cScene.add(new THREE.Points(starGeom, starMat));
      } else if (cCamera) {
        cCamera.aspect = rect.width / rect.height;
        cCamera.updateProjectionMatrix();
      }
    }

    function drawConnectz() {
      if (!cRenderer || !cScene || !cCamera || !cGlobeGroup) return;
      connectzT += 0.01;
      cGlobeGroup.rotation.y = connectzT * 0.35;

      if (cSatGeom) {
        const posAttr = cSatGeom.getAttribute("position") as THREE.BufferAttribute;
        const arr = posAttr.array as Float32Array;
        for (let i = 0; i < cSats.length; i++) {
          const s = cSats[i];
          const a = connectzT * s.speed + s.phase;
          const ox = Math.cos(a) * s.orbitR;
          const oz = Math.sin(a) * s.orbitR;
          arr[i * 3] = ox;
          arr[i * 3 + 1] = oz * Math.sin(s.tilt);
          arr[i * 3 + 2] = oz * Math.cos(s.tilt);
        }
        posAttr.needsUpdate = true;
      }

      cRenderer.render(cScene, cCamera);
      if (connectzRunning) {
        connectzAnimationId = requestAnimationFrame(drawConnectz);
      }
    }

    startConnectz = function () {
      if (connectzRunning) return;
      connectzRunning = true;
      initConnectz();
      drawConnectz();
    };

    stopConnectz = function () {
      connectzRunning = false;
      if (connectzAnimationId) {
        cancelAnimationFrame(connectzAnimationId);
        connectzAnimationId = null;
      }
    };

    // ── Flowers intro video play/pause toggle ──
    const flowersPlayBtn = document.getElementById("flowersPlayBtn") as HTMLButtonElement | null;
    const flowersVideoEl = document.querySelector<HTMLVideoElement>(".flowers-video");

    if (flowersPlayBtn && flowersVideoEl) {
      const playIcon = flowersPlayBtn.querySelector(".play-icon") as HTMLElement;
      function syncPlayIcon() {
        if (!flowersVideoEl) return;
        playIcon.textContent = flowersVideoEl.paused ? "▶" : "❚❚";
        flowersPlayBtn?.classList.toggle("is-playing", !flowersVideoEl.paused);
      }
      flowersPlayBtn.addEventListener("click", () => {
        if (flowersVideoEl.paused) {
          flowersVideoEl.play().catch(() => {/* autoplay blocked, ignore */});
        } else {
          flowersVideoEl.pause();
        }
      });
      flowersVideoEl.addEventListener("play", syncPlayIcon);
      flowersVideoEl.addEventListener("pause", syncPlayIcon);
      flowersVideoEl.addEventListener("ended", syncPlayIcon);
      // Click directly on the video toggles too
      flowersVideoEl.addEventListener("click", () => flowersPlayBtn.click());
    }

    // ── ASCII Osaka flower (three.js + AsciiEffect) ──
    // Procedural 5-petal sakura rendered through the same AsciiEffect pipeline
    // as the site-wide background head. Gently rotates so the petals shimmer.
    const flowerStage = document.getElementById("flowerAsciiStage") as HTMLElement | null;
    const flowerOutput = document.getElementById("flowerAsciiOutput") as HTMLElement | null;

    let fRenderer: THREE.WebGLRenderer | null = null;
    let fScene: THREE.Scene | null = null;
    let fCamera: THREE.PerspectiveCamera | null = null;
    let fFlower: THREE.Group | null = null;
    // The AsciiEffect type isn't exported in a friendly way — use `any` here.
    let fEffect: any = null;
    let fRunning = false;
    let fAnimId: number | null = null;
    let fT = 0;
    let fResizeObs: ResizeObserver | null = null;

    // Per-petal state for the bloom → wither → fall → regrow lifecycle.
    type PetalEntry = {
      arm: THREE.Group;
      pivot: THREE.Group;
      mat: THREE.MeshPhongMaterial;
      baseColor: THREE.Color;
      fallStart: number; // staggered fall window within the lifecycle (0..1)
    };
    let fPetals: PetalEntry[] = [];

    async function initFlower() {
      if (!flowerStage || !flowerOutput || fEffect) return false;

      const rect = flowerStage.getBoundingClientRect();
      // Bail out if the stage hasn't been laid out yet — AsciiEffect crashes
      // on 0-width canvases inside its internal getImageData() call.
      if (rect.width < 8 || rect.height < 8) return false;

      // Dynamic import keeps three's AsciiEffect off the home-route critical path
      const { AsciiEffect } = await import("three/examples/jsm/effects/AsciiEffect.js");

      const w = rect.width;
      const h = rect.height;

      fScene = new THREE.Scene();
      fCamera = new THREE.PerspectiveCamera(34, w / h, 0.1, 100);
      // 3/4 view from above-front, slightly higher than before so the
      // double-layered petals + raised stigma all read in silhouette.
      fCamera.position.set(0, 2.85, 4.3);
      fCamera.lookAt(0, 0.05, 0);

      fRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
      fRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      fRenderer.setSize(w, h, false);
      // Opaque black background so the AsciiEffect reads real dark→light
      // contrast against the void instead of saturating every pixel.
      fRenderer.setClearColor(0x000000, 1);

      // Lights — strong overhead key sculpts deep shadows under the cupped
      // petals + behind the cone stigma. The two pink rims (front and back)
      // separate the front-row petals from the back-row layer so they don't
      // merge into one silhouette in ASCII.
      fScene.add(new THREE.AmbientLight(0xffffff, 0.14));
      const key = new THREE.DirectionalLight(0xffffff, 1.15);
      key.position.set(-1.4, 5.0, 2.4);
      fScene.add(key);
      const rim = new THREE.DirectionalLight(0xff77b0, 0.55);
      rim.position.set(3.0, 1.0, -2.4);
      fScene.add(rim);
      const backRim = new THREE.DirectionalLight(0xff4080, 0.30);
      backRim.position.set(0, -0.6, -3.5);
      fScene.add(backRim);
      // Faint bottom bounce so the stem + leaves catch some shading
      const bounce = new THREE.DirectionalLight(0x4a1830, 0.18);
      bounce.position.set(0, -3.0, 1.5);
      fScene.add(bounce);

      // Flower group — petals + central core + raised stamens + tiny stem
      fFlower = new THREE.Group();
      fScene.add(fFlower);

      // Phong gives nicer specular highlights than Lambert, which translates
      // to more ASCII contrast. Emissive is kept low so directional light can
      // actually carve shadows; without that the petals saturate to one tone.
      const petalMat = new THREE.MeshPhongMaterial({
        color: 0xffc4dc,
        emissive: 0x180408,
        emissiveIntensity: 0.18,
        specular: 0xff9ec2,
        shininess: 28,
      });
      const coreMat = new THREE.MeshPhongMaterial({
        color: 0xff80b0,
        emissive: 0x501020,
        emissiveIntensity: 0.3,
        specular: 0xffffff,
        shininess: 60,
      });
      const stamenMat = new THREE.MeshPhongMaterial({
        color: 0xfff0c0,
        emissive: 0x884420,
        emissiveIntensity: 0.25,
        specular: 0xffffff,
        shininess: 80,
      });
      const filamentMat = new THREE.MeshPhongMaterial({
        color: 0xff90b8,
        emissive: 0x200810,
        emissiveIntensity: 0.15,
      });

      // ── Two layers of cupped petals — front 5 + back 5 offset 36° ──
      // Each petal sits inside an "arm" group rotated around Y (for radial
      // placement) which contains a "pivot" group (for bloom / wither / fall
      // animation). The pivot owns the petal's meshes so animating the pivot
      // moves them all as one cohesive petal. Per-petal cloned material lets
      // opacity + color drift independently during the lifecycle.
      //
      // The back row sits slightly behind (lower z-bias) and lower (smaller y
      // lift) than the front row so its tips peek between the front petals,
      // giving the bloom unmistakable layered depth in ASCII.
      const PETAL_COUNT = 5;
      const frontGeom = new THREE.SphereGeometry(0.58, 24, 16);
      const backGeom = new THREE.SphereGeometry(0.5, 22, 14);
      // Darker tint for the back row → reads as "deeper" / shadowed in ASCII
      const backPetalMat = petalMat.clone();
      backPetalMat.color.setHex(0xff9ec2);
      backPetalMat.emissive.setHex(0x100204);
      backPetalMat.emissiveIntensity = 0.12;

      fPetals = [];

      // Helper to construct one petal (any row)
      function makePetal(opts: {
        angleOffset: number;
        i: number;
        baseMat: THREE.MeshPhongMaterial;
        geom: THREE.SphereGeometry;
        scaleMain: [number, number, number];
        posMain: [number, number, number];
        scaleFold: [number, number, number];
        posFold: [number, number, number];
        addNotch: boolean;
        fallStart: number;
      }): void {
        const a = (opts.i / PETAL_COUNT) * Math.PI * 2 + opts.angleOffset;

        const arm = new THREE.Group();
        arm.rotation.y = a;
        fFlower!.add(arm);

        const pivot = new THREE.Group();
        arm.add(pivot);

        const mat = opts.baseMat.clone();
        mat.transparent = true;
        mat.opacity = 0;
        const baseColor = mat.color.clone();

        // Main lobe
        const petal = new THREE.Mesh(opts.geom, mat);
        petal.scale.set(opts.scaleMain[0], opts.scaleMain[1], opts.scaleMain[2]);
        petal.position.set(opts.posMain[0], opts.posMain[1], opts.posMain[2]);
        pivot.add(petal);

        // Inner fold
        const fold = new THREE.Mesh(opts.geom, mat);
        fold.scale.set(opts.scaleFold[0], opts.scaleFold[1], opts.scaleFold[2]);
        fold.position.set(opts.posFold[0], opts.posFold[1], opts.posFold[2]);
        pivot.add(fold);

        // Tip notch (only on front row — back row stays smooth)
        if (opts.addNotch) {
          const notch = new THREE.Mesh(opts.geom, mat);
          notch.scale.set(0.18, 0.14, 0.18);
          notch.position.set(0, 0.18, 1.78);
          pivot.add(notch);
        }

        fPetals.push({ arm, pivot, mat, baseColor, fallStart: opts.fallStart });
      }

      // Front row — 5 large, fully lifted petals
      for (let i = 0; i < PETAL_COUNT; i++) {
        makePetal({
          angleOffset: 0,
          i,
          baseMat: petalMat,
          geom: frontGeom,
          scaleMain: [0.95, 0.22, 1.55],
          posMain: [0, 0.05, 1.18],
          scaleFold: [0.42, 0.18, 0.6],
          posFold: [0, 0.02, 0.5],
          addNotch: true,
          fallStart: 0.60 + i * 0.04,
        });
      }

      // Back row — 5 smaller petals offset 36°, slightly behind & lower
      for (let i = 0; i < PETAL_COUNT; i++) {
        makePetal({
          angleOffset: Math.PI / PETAL_COUNT, // 36° between front and back
          i,
          baseMat: backPetalMat,
          geom: backGeom,
          scaleMain: [0.85, 0.20, 1.35],
          // Slightly lower y, slightly closer to center, recede in z (-)
          posMain: [0, -0.06, 1.02],
          scaleFold: [0.36, 0.16, 0.55],
          posFold: [0, -0.04, 0.42],
          addNotch: false,
          // Back petals fall 0.02 later than their angle-paired front petal,
          // so the cascade reads as "front falls, then the back layer behind
          // it is revealed briefly, then it falls too".
          fallStart: 0.62 + i * 0.04,
        });
      }

      // ── Central pistil tower ──
      // A short cone (stigma) crowned with a bright sphere, on top of a wider
      // disc that hides the petal seams. Much more depth than a single dome:
      // the cone catches a hard top-light highlight that ASCII renders as a
      // bright spike, with shadowed sides falling off into the petals.
      const baseDisc = new THREE.Mesh(
        new THREE.CylinderGeometry(0.36, 0.4, 0.16, 20),
        coreMat,
      );
      baseDisc.position.y = 0.04;
      fFlower.add(baseDisc);

      const stigma = new THREE.Mesh(
        new THREE.ConeGeometry(0.26, 0.55, 18),
        coreMat,
      );
      stigma.position.y = 0.36;
      fFlower.add(stigma);

      // Bright cap on top of the stigma — the brightest spot in the scene
      const stigmaCapMat = new THREE.MeshPhongMaterial({
        color: 0xfff0e0,
        emissive: 0xffb866,
        emissiveIntensity: 0.45,
        specular: 0xffffff,
        shininess: 100,
      });
      const stigmaCap = new THREE.Mesh(
        new THREE.SphereGeometry(0.10, 14, 10),
        stigmaCapMat,
      );
      stigmaCap.position.y = 0.66;
      fFlower.add(stigmaCap);

      // ── Calyx (back sepals) ──
      // Five small darker sepals tucked behind/below the petals — they read
      // as a dark ring beneath the flower, anchoring it visually.
      const calyxMat = new THREE.MeshPhongMaterial({
        color: 0x7a3a52,
        emissive: 0x0a0306,
        emissiveIntensity: 0.08,
        shininess: 6,
      });
      const calyxGeom = new THREE.SphereGeometry(0.28, 14, 10);
      for (let i = 0; i < 5; i++) {
        const a = (i / 5) * Math.PI * 2 + Math.PI / 10;
        const sepal = new THREE.Mesh(calyxGeom, calyxMat);
        sepal.scale.set(0.42, 0.18, 0.72);
        sepal.position.set(Math.cos(a) * 0.56, -0.16, Math.sin(a) * 0.56);
        sepal.rotation.y = -a + Math.PI / 2;
        sepal.rotation.x = 0.55; // tilt downward + outward
        fFlower.add(sepal);
      }

      // Filament + anther stamens rising out of the core like little match-heads.
      // The vertical filaments + bright anther tips give the flower its
      // unmistakable "interior" detail when rendered in ASCII.
      const filamentGeom = new THREE.CylinderGeometry(0.018, 0.024, 0.45, 6);
      const antherGeom = new THREE.SphereGeometry(0.07, 10, 8);
      const STAMEN_COUNT = 9;
      for (let i = 0; i < STAMEN_COUNT; i++) {
        const a = (i / STAMEN_COUNT) * Math.PI * 2 + 0.18;
        const r = 0.22 + (i % 2 === 0 ? 0.04 : 0);
        const fx = Math.cos(a) * r;
        const fz = Math.sin(a) * r;
        const tilt = 0.18; // splay outward
        const filament = new THREE.Mesh(filamentGeom, filamentMat);
        filament.position.set(fx, 0.34, fz);
        filament.rotation.z = -Math.cos(a) * tilt;
        filament.rotation.x = Math.sin(a) * tilt;
        fFlower.add(filament);

        const anther = new THREE.Mesh(antherGeom, stamenMat);
        anther.position.set(fx * 1.18, 0.56, fz * 1.18);
        fFlower.add(anther);
      }

      // A tapered stem dropping out of the bottom of the frame — anchors
      // the flower in space and gives the scene a clear "depth axis".
      const stemGeom = new THREE.CylinderGeometry(0.07, 0.04, 1.7, 10);
      const stemMat = new THREE.MeshPhongMaterial({
        color: 0xc05878,
        emissive: 0x140408,
        emissiveIntensity: 0.15,
        shininess: 18,
      });
      const stem = new THREE.Mesh(stemGeom, stemMat);
      stem.position.y = -0.95;
      fFlower.add(stem);

      // ── Two leaves on the stem ──
      // Sphere-derived leaf shapes flanking the stem. They use a darker
      // tint than the stem so the contrast reads as separate forms in ASCII
      // and they grounded the whole composition as unambiguously a flower.
      const leafMat = new THREE.MeshPhongMaterial({
        color: 0xa84e72,
        emissive: 0x180814,
        emissiveIntensity: 0.13,
        shininess: 14,
      });
      const leafGeom = new THREE.SphereGeometry(0.42, 16, 12);
      // Upper-left leaf
      const leafL = new THREE.Mesh(leafGeom, leafMat);
      leafL.scale.set(0.95, 0.10, 0.36);
      leafL.position.set(-0.6, -0.95, 0.05);
      leafL.rotation.z = 0.55;
      leafL.rotation.y = -0.45;
      fFlower.add(leafL);
      // Lower-right leaf
      const leafR = new THREE.Mesh(leafGeom, leafMat);
      leafR.scale.set(0.88, 0.10, 0.32);
      leafR.position.set(0.5, -1.42, -0.08);
      leafR.rotation.z = -0.6;
      leafR.rotation.y = 0.4;
      fFlower.add(leafR);

      // ── Mount the AsciiEffect renderer into our stage ──
      // 21-char ramp at resolution 0.20 → enough glyph variety to render the
      // bloom + cone stigma + back-row petals with distinct shading bands.
      fEffect = new AsciiEffect(fRenderer, " .'`,:;-=+*o?%xSC#W@$", {
        invert: true,
        resolution: 0.20,
        scale: 1,
      });
      fEffect.setSize(w, h);
      fEffect.domElement.style.color = "#ff6fa3";
      fEffect.domElement.style.backgroundColor = "transparent";
      fEffect.domElement.style.fontFamily = "var(--font-mono, monospace)";
      fEffect.domElement.style.letterSpacing = "0";
      fEffect.domElement.style.lineHeight = "1";
      flowerOutput.innerHTML = "";
      flowerOutput.appendChild(fEffect.domElement);

      // Re-size when the stage resizes (responsive)
      fResizeObs = new ResizeObserver(() => {
        if (!flowerStage || !fEffect || !fCamera || !fRenderer) return;
        const r = flowerStage.getBoundingClientRect();
        if (r.width < 8 || r.height < 8) return;
        fCamera.aspect = r.width / r.height;
        fCamera.updateProjectionMatrix();
        fRenderer.setSize(r.width, r.height, false);
        fEffect.setSize(r.width, r.height);
      });
      fResizeObs.observe(flowerStage);

      return true;
    }

    // Smooth Hermite ease between two edges — used to ramp lifecycle phases.
    function smoothstep(e0: number, e1: number, x: number): number {
      const t = Math.max(0, Math.min(1, (x - e0) / (e1 - e0)));
      return t * t * (3 - 2 * t);
    }
    function lerp(a: number, b: number, t: number): number {
      return a + (b - a) * t;
    }

    // ── Lifecycle phase timings (within a single normalized 0..1 cycle) ──
    //   0.00 – 0.20  BLOOM    petals scale up from bud and unfurl outward
    //   0.20 – 0.55  OPEN     fully bloomed, gentle sway
    //   0.55 – 0.65  WITHER   petals droop, color drifts to plum
    //   0.62 – 0.95  FALL     petals drop off one-by-one (staggered)
    //   0.95 – 1.00  BARE     bare stem holds before the next bud
    const LIFECYCLE_PERIOD = 18; // seconds per full cycle

    // Withered tint — desaturated plum
    const WITHERED_COLOR = new THREE.Color(0x6a2034);

    // Anchor for wall-clock lifecycle progression (so the cycle advances by
    // real seconds, not frame count — RAF can be throttled when offscreen).
    let fStartMs = 0;

    function tickFlower() {
      if (!fRunning) return;
      if (fStartMs === 0) fStartMs = performance.now();
      const elapsedSec = (performance.now() - fStartMs) / 1000;
      // Keep fT in sync for the head-spin animation
      fT = elapsedSec;

      // ── Single-bloom lifecycle: bloom → wither → fall → regrow ──
      const tCycle = (elapsedSec % LIFECYCLE_PERIOD) / LIFECYCLE_PERIOD;
      const bloom = smoothstep(0.02, 0.20, tCycle);
      const wither = smoothstep(0.55, 0.65, tCycle);

      if (fFlower) {
        // Slow Y-axis spin around the stem so we always read the petals from
        // a 3/4 perspective. Wind sway dampens as the flower withers.
        const swayDamp = 1 - wither * 0.6;
        fFlower.rotation.y = fT * 0.22;
        fFlower.rotation.x = Math.sin(fT * 0.55) * 0.06 * swayDamp;
        fFlower.rotation.z = Math.cos(fT * 0.45) * 0.05 * swayDamp;
      }

      // ── Per-petal animation ──
      for (let i = 0; i < fPetals.length; i++) {
        const p = fPetals[i];
        const fall = smoothstep(p.fallStart, p.fallStart + 0.10, tCycle);
        const scale = bloom * (1 - fall);
        p.pivot.scale.setScalar(scale);

        const openAngle = lerp(-Math.PI / 2, -0.42, bloom);
        const witherDroop = wither * 0.55;
        const fallDroop = fall * 1.1;
        p.pivot.rotation.x = openAngle + witherDroop + fallDroop;

        const swayPhase = i * 1.3;
        p.pivot.rotation.z =
          Math.sin(fT * 0.9 + swayPhase) * 0.05 * bloom * (1 - wither);

        p.pivot.position.y = -fall * 1.8;
        p.pivot.position.z = fall * 0.55;

        p.mat.opacity = Math.max(0, Math.min(1, bloom * (1 - fall * 0.92)));

        const tint = Math.min(1, wither + fall * 0.45);
        p.mat.color.copy(p.baseColor).lerp(WITHERED_COLOR, tint);
      }

      if (fEffect && fScene && fCamera && flowerStage) {
        const r = flowerStage.getBoundingClientRect();
        if (r.width >= 8 && r.height >= 8) {
          try {
            fEffect.render(fScene, fCamera);
          } catch (err) {
            // AsciiEffect can throw a transient IndexSizeError if the canvas
            // is mid-resize. Swallow it — the next RAF tick recovers.
          }
        }
      }

      fAnimId = requestAnimationFrame(tickFlower);
    }

    // Wait for the stage to actually have layout before bootstrapping the
    // three.js scene. Without this guard, AsciiEffect crashes on a 0-width
    // canvas via getImageData().
    function waitForStageLayout(maxTries = 30): Promise<boolean> {
      return new Promise((resolve) => {
        let tries = 0;
        const check = () => {
          if (!flowerStage) return resolve(false);
          const r = flowerStage.getBoundingClientRect();
          if (r.width >= 8 && r.height >= 8) return resolve(true);
          if (++tries >= maxTries) return resolve(false);
          requestAnimationFrame(check);
        };
        check();
      });
    }

    startFlower = function () {
      if (fRunning) return;
      fRunning = true;
      (async () => {
        const ready = await waitForStageLayout();
        if (!ready || !fRunning) return;
        const ok = await initFlower();
        if (ok && fRunning) tickFlower();
      })().catch((err) => {
        console.warn("[flower] init failed", err);
      });
    };

    stopFlower = function () {
      fRunning = false;
      fStartMs = 0; // restart the lifecycle from "bud" next time
      if (fAnimId !== null) {
        cancelAnimationFrame(fAnimId);
        fAnimId = null;
      }
    };
  });
</script>

